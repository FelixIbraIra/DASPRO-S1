        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;primaryColor&#39;: &#39;#ffffff&#39;, &#39;primaryTextColor&#39;: &#39;#000000&#39;, &#39;primaryBorderColor&#39;: &#39;#000000&#39;, &#39;lineColor&#39;: &#39;#000000&#39;, &#39;tertiaryColor&#39;: &#39;#ffffff&#39;}}}%%\nflowchart TD\n    Start([Start]) --&gt; Init[totalPendapatan = 0&lt;br/&gt;pendapatanTertinggi = 0&lt;br/&gt;hariMelebihi1Juta = 0&lt;br/&gt;hari = 1]\n    \n    Init --&gt; CondHari{hari &lt;= 7?}\n    \n    CondHari -- Ya --&gt; InputPend[/Input pendapatan/]\n    InputPend --&gt; AddTotal[totalPendapatan = totalPendapatan + pendapatan]\n    \n    AddTotal --&gt; CondHari1{hari == 1?}\n    CondHari1 -- Ya --&gt; SetMaxFirst[pendapatanTertinggi = pendapatan]\n    CondHari1 -- Tidak --&gt; CondMax{pendapatan &gt; pendapatanTertinggi?}\n    \n    CondMax -- Ya --&gt; SetMax[pendapatanTertinggi = pendapatan]\n    CondMax -- Tidak --&gt; CondJuta\n    SetMaxFirst --&gt; CondJuta{pendapatan &gt; 1000000?}\n    SetMax --&gt; CondJuta\n    \n    CondJuta -- Ya --&gt; IncJuta[hariMelebihi1Juta = hariMelebihi1Juta + 1]\n    CondJuta -- Tidak --&gt; IncHari[hari = hari + 1]\n    IncJuta --&gt; IncHari\n    \n    IncHari --&gt; CondHari\n    \n    CondHari -- Tidak --&gt; CalcAvg[rataRata = totalPendapatan / 7]\n    CalcAvg --&gt; PrintRes[/Print totalPendapatan,&lt;br/&gt;rataRata, pendapatanTertinggi,&lt;br/&gt;hariMelebihi1Juta/]\n    PrintRes --&gt; End([End])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Fu0j7dlHB-aniHR2cMj-306">
