        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ArrowColor black\n\nstart\n\n:Read bil/\n\nif (Apakah\\nbil &lt;= 1?) then (Ya)\n  :Display \&quot;Bukan Prima\&quot;/\n  stop\nelse (Tidak)\n  :pembagi = 0, i = 1;\n  \n  while (Apakah\\ni &lt;= bil?) is (Ya)\n    if (Apakah\\nbil MOD i == 0?) then (Ya)\n      :pembagi = pembagi + 1;\n    else (Tidak)\n    endif\n    :i = i + 1;\n  endwhile (Tidak)\n  \n  if (Apakah\\npembagi == 2?) then (Ya)\n    :Display \&quot;Bilangan Prima\&quot;/\n  else (Tidak)\n    :Display \&quot;Bukan Prima\&quot;/\n  endif\n  \n  stop\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Fu0j7dlHB-aniHR2cMj-147">
